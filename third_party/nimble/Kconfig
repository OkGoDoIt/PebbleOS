menu "NimBLE BLE stack"

choice
    prompt "SF32LB52 HCI trace"
    default NIMBLE_HCI_SF32LB52_TRACE_NONE
    depends on BT_HCI_SF32LB52
    help
      Trace mode for the SF32LB52 HCI transport.

config NIMBLE_HCI_SF32LB52_TRACE_NONE
    bool "Disabled"

config NIMBLE_HCI_SF32LB52_TRACE_BINARY
    bool "Binary"
    help
      Capture raw HCI traffic in a binary format suitable for offline
      decoding.

config NIMBLE_HCI_SF32LB52_TRACE_LOG
    bool "Log"
    help
      Emit human-readable HCI trace lines through the standard logger.

config NIMBLE_HCI_SF32LB52_TRACE_EVENTS
    bool "Events and commands only"
    help
      Log one line per HCI command and per HCI event (except Number Of
      Completed Packets) at INFO level in the NimBLE module, without
      payloads or ACL data. Cheap enough to leave on while a phone link
      streams; shows what the controller reported about advertising,
      connections and their failures.

endchoice

choice "NIMBLE_LOG_LEVEL_CHOICE"
    default NIMBLE_LOG_LEVEL_OFF
endchoice

module = NIMBLE
module-str = NimBLE host
source "subsys/logging/Kconfig.template.log_level"

# NimBLE's own options, generated from its syscfg.yml files by
# scripts/gen_syscfg.py. PebbleOS-wide values live in
# subsys/bluetooth/Kconfig.defconfig, per-SoC ones in soc/*/Kconfig.defconfig.
rsource "Kconfig.ble"
rsource "Kconfig.host"
rsource "Kconfig.svcs"
rsource "Kconfig.transport"
rsource "Kconfig.controller"
rsource "Kconfig.drivers"
rsource "Kconfig.port"

endmenu
